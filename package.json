{
  "name": "navyfield-yamato-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "convert:yamato": "node tools/models/convert-yamato.mjs",
    "convert:ships": "node tools/models/convert-ships.mjs",
    "generate:ships": "node tools/models/generate-original-ships.mjs && node tools/models/register-original-ships.mjs",
    "index:models": "node tools/models/index-models.mjs",
    "prepare:content": "node tools/packaging/prepare-content.mjs",
    "predev": "npm run prepare:content",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:content",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
